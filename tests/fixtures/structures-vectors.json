{
  "description": "Vectores compartidos por las estructuras TypeScript (src/core/structures) y Python (app/core/structures). Cambiar en ambos repos a la vez. expect: valor esperado, o {\"throws\": true} si la operación debe fallar.",
  "cases": [
    {
      "name": "queue vacía",
      "structure": "queue",
      "ops": [
        { "call": "is_empty", "expect": true },
        { "call": "dequeue", "expect": null },
        { "call": "peek", "expect": null },
        { "call": "size", "expect": 0 }
      ]
    },
    {
      "name": "queue FIFO",
      "structure": "queue",
      "ops": [
        { "call": "enqueue", "args": [1], "expect": null },
        { "call": "enqueue", "args": [2], "expect": null },
        { "call": "enqueue", "args": [3], "expect": null },
        { "call": "size", "expect": 3 },
        { "call": "peek", "expect": 1 },
        { "call": "dequeue", "expect": 1 },
        { "call": "dequeue", "expect": 2 },
        { "call": "dequeue", "expect": 3 },
        { "call": "is_empty", "expect": true }
      ]
    },
    {
      "name": "stack LIFO",
      "structure": "stack",
      "ops": [
        { "call": "is_empty", "expect": true },
        { "call": "pop", "expect": null },
        { "call": "push", "args": [1], "expect": null },
        { "call": "push", "args": [2], "expect": null },
        { "call": "push", "args": [3], "expect": null },
        { "call": "size", "expect": 3 },
        { "call": "peek", "expect": 3 },
        { "call": "pop", "expect": 3 },
        { "call": "pop", "expect": 2 },
        { "call": "size", "expect": 1 },
        { "call": "pop", "expect": 1 },
        { "call": "pop", "expect": null },
        { "call": "is_empty", "expect": true }
      ]
    },
    {
      "name": "lista simple con inserción en extremos y remove",
      "structure": "singly_linked_list",
      "ops": [
        { "call": "append", "args": ["b"], "expect": null },
        { "call": "prepend", "args": ["a"], "expect": null },
        { "call": "append", "args": ["c"], "expect": null },
        { "call": "to_array", "expect": ["a", "b", "c"] },
        { "call": "remove", "args": ["missing"], "expect": false },
        { "call": "remove", "args": ["b"], "expect": true },
        { "call": "to_array", "expect": ["a", "c"] },
        { "call": "pop_front", "expect": "a" },
        { "call": "pop_front", "expect": "c" },
        { "call": "pop_front", "expect": null },
        { "call": "size", "expect": 0 }
      ]
    },
    {
      "name": "min-heap: orden de prioridad con swaps y decrease_key por ID",
      "structure": "min_heap",
      "ops": [
        { "call": "insert", "args": [{ "id": "a", "priority": 10 }], "expect": null },
        { "call": "insert", "args": [{ "id": "b", "priority": 4 }], "expect": null },
        { "call": "insert", "args": [{ "id": "c", "priority": 8 }], "expect": null },
        { "call": "insert", "args": [{ "id": "d", "priority": 2 }], "expect": null },
        { "call": "insert", "args": [{ "id": "e", "priority": 6 }], "expect": null },
        { "call": "extract_min", "expect": { "id": "d", "priority": 2 } },
        { "call": "extract_min", "expect": { "id": "b", "priority": 4 } },
        { "call": "decrease_key", "args": ["a", { "id": "a", "priority": 1 }], "expect": null },
        { "call": "extract_min", "expect": { "id": "a", "priority": 1 } },
        { "call": "extract_min", "expect": { "id": "e", "priority": 6 } },
        { "call": "extract_min", "expect": { "id": "c", "priority": 8 } },
        { "call": "extract_min", "expect": null },
        { "call": "is_empty", "expect": true }
      ]
    },
    {
      "name": "min-heap: IDs duplicados, IDs inexistentes e incrementos de prioridad fallan",
      "structure": "min_heap",
      "ops": [
        { "call": "insert", "args": [{ "id": "a", "priority": 1 }], "expect": null },
        { "call": "insert", "args": [{ "id": "a", "priority": 5 }], "expect": { "throws": true } },
        { "call": "insert", "args": [{ "id": "c", "priority": 3 }], "expect": null },
        { "call": "decrease_key", "args": ["zz", { "id": "zz", "priority": 0 }], "expect": { "throws": true } },
        { "call": "decrease_key", "args": ["a", { "id": "b", "priority": 0 }], "expect": { "throws": true } },
        { "call": "decrease_key", "args": ["c", { "id": "c", "priority": 9 }], "expect": { "throws": true } },
        { "call": "size", "expect": 2 },
        { "call": "extract_min", "expect": { "id": "a", "priority": 1 } }
      ]
    }
  ]
}
