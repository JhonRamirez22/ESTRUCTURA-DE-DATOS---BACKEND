# Solo nombres de variables; los valores reales viven en Secrets Manager o en tu .env local.
NODE_ENV=development
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=rutas_pasto
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_MODE=disable
AUTH_SECRET=                      # mínimo 32 bytes; obligatorio en producción
APP_ALLOWED_ORIGINS=["http://localhost:3000"]
ROUTING_PROVIDER=osrm
OSRM_API_URL=https://router.project-osrm.org
TOMTOM_API_KEY=
AI_TRAFFIC_PROVIDER=groq
CUSTOMER_CHAT_API_KEY=
